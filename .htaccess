RewriteEngine On

# Django Passenger application
RewriteRule ^a(/.*)?$ - [L]

# Любой запрос -> frontend/dist/<путь>
RewriteCond %{REQUEST_URI} !^/frontend/dist/
RewriteRule ^(.+)$ frontend/dist/$1 [L]

# Не файл, и (корень или не каталог) -> index.html
RewriteCond %{REQUEST_URI} !\.(js|css|svg|png|jpe?g|gif|webp|avif|ico|woff2?|ttf|eot|map|json)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} ^/$ [OR]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ frontend/dist/index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpe?g|gif|webp|avif|ico|woff2?|ttf|eot|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
