RewriteEngine On
RewriteBase /

# API -> Django backend
RewriteRule ^api(/.*)?$ http://127.0.0.1:443/api$1 [P,L]

# Hide backend and source files from the web
RewriteRule ^backend(/|$) - [F,L]
RewriteRule ^frontend/src(/|$) - [F,L]
RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^\.env$ - [F,L]

# Serve existing files from the frontend build
# ($1 avoids REQUEST_URI pitfalls: query strings, encoded chars)
RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -d
RewriteRule ^(.*)$ frontend/dist/$1 [L]

# SPA fallback: any other route -> index.html
RewriteRule ^(.*)$ frontend/dist/index.html [L]

<FilesMatch "^\.env$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(js|mjs|css|json|woff2?|png|jpg|jpeg|gif|svg|webp|ico|map)$">
  Header unset ETag
  FileETag None
</FilesMatch>