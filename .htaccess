RewriteEngine On

# Django Passenger application
RewriteRule ^a(/.*)?$ - [L]

# Existing files/directories (кроме корня — там должен отвечать React)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^ - [L]

# React SPA
RewriteRule ^ frontend/dist/index.html [L]